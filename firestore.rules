rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /contributions/{contributionId} {

      // Everyone may read the kiddush list.
      allow read: if true;

      // Seeding the list, adding an item through the "אחר" card, and the
      // admin reset all write whole documents, so every write is checked
      // against the document shape instead of against a field allowlist.
      allow create, update: if isValidShape(request.resource.data)
                            && request.resource.data.registeredFamilies.size()
                               <= request.resource.data.quantityRequired;

      // Only items a family added themselves can be removed, which is what
      // the reset does. The nine seeded items can never be deleted.
      allow delete: if resource.data.isCustom == true;
    }

    // Nothing else is reachable from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidShape(data) {
    return data.keys().hasAll(['title', 'icon', 'tint', 'quantityRequired', 'registeredFamilies'])
           && data.title is string && data.title.size() > 0 && data.title.size() <= 80
           && data.icon is string
           && data.tint is string
           && data.quantityRequired is int
           && data.quantityRequired >= 1 && data.quantityRequired <= 50
           && data.registeredFamilies is list
           && data.registeredFamilies.size() <= 50;
  }
}

// NOTE: this project has no authentication layer, so these rules constrain the
// shape of the data but not who may write it. The reset password is checked in
// the browser only. To make the reset genuinely privileged, add Firebase Auth,
// move the reset behind a Cloud Function, and require a custom claim here.
